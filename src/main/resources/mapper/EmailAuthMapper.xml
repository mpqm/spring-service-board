<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.service.board.member.dao.EmailAuthDao">

    <!-- 이메일 인증 추가 -->
    <insert id="createEmailAuth" parameterType="com.service.board.member.dto.CreateEmailAuthReq" useGeneratedKeys="true" keyProperty="idx">
        INSERT INTO TB_EMAIL_AUTH (
            member_idx,
            uuid,
            created_at
        ) VALUES (
            #{memberIdx},
            #{uuid},
            CURRENT_TIMESTAMP
        )
    </insert>

    <!-- 이메일 인증 조회 -->
    <select id="getEmailAuth" parameterType="com.service.board.member.dto.GetEmailAuthReq" resultType="com.service.board.member.dto.GetEmailAuthRes">
        SELECT 
            idx,
            member_idx as memberIdx,
            uuid,
            created_at as createdAt
        FROM TB_EMAIL_AUTH 
        WHERE member_idx = #{memberIdx} AND uuid = #{uuid}
    </select>

    <!-- 이메일 인증 삭제 -->
    <delete id="deleteEmailAuth" parameterType="com.service.board.member.dto.DeleteEmailAuthReq">
        DELETE FROM TB_EMAIL_AUTH 
        WHERE member_idx = #{memberIdx} AND uuid = #{uuid}
    </delete>

</mapper>