<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.board.common.member.dao.EmailAuthDao">

    <!-- 이메일 인증 추가 -->
    <insert id="createEmailAuth" parameterType="CreateEmailAuthReq" useGeneratedKeys="true" keyProperty="idx">
        INSERT INTO TB_EMAIL_AUTH (
            id,
            uuid,
            created_at
        ) VALUES (
            #{id},
            #{uuid},
            CURRENT_TIMESTAMP
        )
    </insert>

    <!-- 이메일 인증 조회 -->
    <select id="getEmailAuth" parameterType="GetEmailAuthReq" resultType="GetEmailAuthRes">
        SELECT 
            idx,
            id,
            uuid,
            created_at as createdAt
        FROM TB_EMAIL_AUTH 
        WHERE id = #{id}
    </select>

    <!-- 이메일 인증 삭제 -->
    <delete id="deleteEmailAuth" parameterType="DeleteEmailAuthReq">
        DELETE FROM TB_EMAIL_AUTH 
        WHERE id = #{id}
    </delete>

</mapper>