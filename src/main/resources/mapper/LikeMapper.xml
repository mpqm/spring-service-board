<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.service.board.react.dao.LikeDao">
    <!-- 게시물/댓글 좋아요 등록 -->
    <insert id="createLike" parameterType="CreateReactReq" useGeneratedKeys="true" keyProperty="idx">
        INSERT INTO TB_LIKE (
            member_idx,
            <choose>
                <when test="postIdx != null">
                    post_idx
                </when>
                <otherwise>
                    comment_idx
                </otherwise>
            </choose>
        ) VALUES (
            #{memberIdx},
            <choose>
                <when test="postIdx != null">
                    #{postIdx}
                </when>
                <otherwise>
                    #{commentIdx}
                </otherwise>
            </choose>
        )
    </insert>

    <!-- 게시물/댓글 좋아요 조회 -->
    <select id="getLike" parameterType="GetReactReq" resultType="GetReactRes">
        SELECT 
            idx,
            member_idx as memberIdx,
            <choose>
                <when test="postIdx != null">
                    post_idx as postIdx,
                    NULL as commentIdx
                </when>
                <otherwise>
                    NULL as postIdx,
                    comment_idx as commentIdx
                </otherwise>
            </choose>
        FROM TB_LIKE
        WHERE member_idx = #{memberIdx}
        <choose>
            <when test="postIdx != null">
                AND post_idx = #{postIdx}
            </when>
            <otherwise>
                AND comment_idx = #{commentIdx}
            </otherwise>
        </choose>
    </select>

    <!-- 게시물/댓글 좋아요 개수 조회 -->
    <select id="countLike" parameterType="CountReactReq" resultType="Long">
        SELECT COUNT(*)
        FROM TB_LIKE
        <where>
            <choose>
                <when test="postIdx != null">
                    post_idx = #{postIdx}
                </when>
                <otherwise>
                    comment_idx = #{commentIdx}
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- 게시물/댓글 좋아요 삭제 -->
    <delete id="deleteLike" parameterType="DeleteReactReq">
        DELETE FROM TB_LIKE
        WHERE member_idx = #{memberIdx}
        <choose>
            <when test="postIdx != null">
                AND post_idx = #{postIdx}
            </when>
            <otherwise>
                AND comment_idx = #{commentIdx}
            </otherwise>
        </choose>
    </delete>
</mapper>