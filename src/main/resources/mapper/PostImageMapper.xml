<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.service.board.post.dao.PostImageDao">
    <!-- 게시물 이미지 등록 -->
    <insert id="createPostImage" parameterType="CreatePostImageReq" useGeneratedKeys="true" keyProperty="idx">
        INSERT INTO TB_POST_IMAGE (
            post_idx,
            image_url,
            created_at,
        ) VALUES (
            #{postIdx},
            #{imageUrl},
            CURRENT_TIMESTAMP,
        )
    </insert>

    <!-- 게시물 이미지 목록 조회 -->
    <select id="getPostImages" parameterType="GetPostImageReq" resultType="GetPostImageRes">
        SELECT 
            idx,
            post_idx as postIdx,
            image_url as imageUrl,
            created_at as createdAt,
        FROM TB_POST_IMAGE
        WHERE post_idx = #{postIdx}
        ORDER BY idx ASC
    </select>

    <!-- 게시물 이미지 삭제 -->
    <delete id="deletePostImage" parameterType="DeletePostImageReq">
        DELETE FROM TB_POST_IMAGE
        WHERE idx = #{idx}
    </delete>

</mapper> 